# ==============================================================================
# 🛡️ .gitignore: Файлы, которые Git будет игнорировать при отправке на GitHub
# ==============================================================================

# 🔐 Секреты, ключи и токены
.env
.env.*
*.env
*.pem
*.key

# 📦 Зависимости Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ⚙️ Временные папки сборок и кэш
dist/
chess-assistant_phone/
*.tmp
*.log
.cache/

# 🗜️ Большие архивы и скомпилированные бинарники (>50 МБ)
stockfish-19-full.wasm
*.xpi
*.rar
*.zip.bak

# 🖥️ Служебные файлы операционных систем
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 🤖 Внутренние служебные конфигурации агентов
.gemini/
GEMINI.md
CLAUDE.md
AGENTS.md
