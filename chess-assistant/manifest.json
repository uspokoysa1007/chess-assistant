{
  "manifest_version": 3,
  "name": "Шахматный Помощник",
  "version": "2.4",
  "description": "Шахматный плагин со Stockfish 19 для Chess.com и Lichess",
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "48": "icons/pawn.svg",
    "96": "icons/pawn.svg"
  },
  "action": {
    "default_icon": "icons/pawn.svg",
    "default_title": "Шахматный Помощник"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{a4c8e910-7d3b-4e2a-9f61-8b2d4c5e7a90}",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*",
        "*://lichess.org/*",
        "*://*.lichess.org/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
